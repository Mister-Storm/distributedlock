# Docker's internal DNS resolver — required for dynamic $variable upstreams in proxy_pass
resolver 127.0.0.11 valid=5s;

upstream lock_nodes {
    server node1:8080;
    server node2:8080;
    server node3:8080;
    server node4:8080;
    server node5:8080;
    server node6:8080;
}

server {
    listen ${PROXY_PORT};

    access_log /dev/stdout lock_trace;

    # Raft endpoints — accessible only from Docker/internal networks
    location ~ ^/([^/]+)/raft(/.*)$ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        set $node_upstream $1;
        set $path_rest     /raft$2;

        proxy_pass http://$node_upstream:8080$path_rest;

        proxy_redirect ~^http://distributedlock-proxy:${PROXY_PORT}(/.*)$ http://$http_host$1;

        proxy_set_header Host             $host;
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id     $request_id;
    }

    # Public lock API — round-robin across all nodes
    location /v1/lock {
        proxy_pass http://lock_nodes/lock;

        proxy_redirect ~^http://distributedlock-proxy:${PROXY_PORT}/v1(.*)$ http://$http_host/v1$1;

        proxy_set_header Host             $host;
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id     $request_id;
    }
}
